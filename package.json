{
  "name": "mcpx",
  "version": "0.1.0",
  "description": "Reliable transaction runtime for WebMCP workflows with uncertainty recovery and verified compensation",
  "private": true,
  "license": "Apache-2.0",
  "author": "MCPx Contributors",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:mcpx": "pnpm --filter mcpx-web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "tsx tests/integration/reliability.test.ts",
    "test:integration": "tsx tests/integration/reliability.test.ts",
    "test:sdk": "pnpm --filter @mcpxx/sdk test",
    "demo:sdk": "pnpm --filter sdk-agent-demo start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "bootstrap": "bash scripts/dev-bootstrap.sh"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
