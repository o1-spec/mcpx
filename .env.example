# ==============================================================================
# MCPx Environment Configuration Template
# ==============================================================================

# Control & Resource Database Connection
# In local development: defaults to localhost:5435
# In production: supply managed PostgreSQL connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL=postgresql://mcpx:mcpx@localhost:5435/mcpx_control

# Public Origin Architecture (Leave empty in local dev to use localhost fallbacks)
# In production: supply the public HTTPS URLs for each independently deployed service.

# 1. MCPx Main Web Application & Dashboard (Coordinator)
NEXT_PUBLIC_MCPX_ORIGIN=http://localhost:3000

# 2. Reference Service: Routing Gateway
NEXT_PUBLIC_ROUTING_ORIGIN=http://localhost:3001

# 3. Reference Service: PostgreSQL Database Provisioner
NEXT_PUBLIC_DATABASE_ORIGIN=http://localhost:3002

# 4. Reference Service: Compute Backend Runtime
NEXT_PUBLIC_COMPUTE_ORIGIN=http://localhost:3003

# 5. Reference Service: Frontend Host & Preview Provider
NEXT_PUBLIC_FRONTEND_ORIGIN=http://localhost:3004

# 6. Optional External 5th Service Provider
NEXT_PUBLIC_EXAMPLE_SERVICE_ORIGIN=http://localhost:3010
