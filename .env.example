# ==============================================================================
# MCPx Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local before running the platform locally.

# Node Environment
NODE_ENV=development

# MCPx Control Plane Database (PostgreSQL)
# Default maps to docker-compose postgres container on port 5435
MCPX_PG_HOST=localhost
MCPX_PG_PORT=5435
MCPX_PG_USER=mcpx
MCPX_PG_PASSWORD=mcpx
MCPX_PG_DATABASE=mcpx_control
DATABASE_URL=postgresql://mcpx:mcpx@localhost:5435/mcpx_control

# Local Service Origins (Ports configured across reference WebMCP apps)
NEXT_PUBLIC_MCPX_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ROUTING_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_DATABASE_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_COMPUTE_SERVICE_URL=http://localhost:3003
NEXT_PUBLIC_FRONTEND_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_EXAMPLE_EXTERNAL_SERVICE_URL=http://localhost:3010

# WebMCP Protocol Isolation Settings
MCPX_ALLOW_UNENCRYPTED_POSTMESSAGE=true
